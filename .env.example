# Local development values. ./deploy.sh dev copies this file to .env, which compose reads.
# Production never sees this file: its deploy writes .env from the repository secrets.
SECRET_KEY=CHANGE_ME_min_32_chars_long_!!!!
MONGO_USER=root
MONGO_PASSWORD=rootpassword
REDIS_PASSWORD=redispassword
MONGO_MONITOR_PASSWORD=monitorpassword
ADMIN_USER_PASSWORD=admin123
DEFAULT_USER_PASSWORD=user123
GRAFANA_ADMIN_PASSWORD=admin123
