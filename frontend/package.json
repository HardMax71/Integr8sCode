{
    "name": "svelte-app",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "preview": "vite preview",
        "prepare": "svelte-kit sync || echo ''",
        "generate:api": "svelte-kit sync && openapi-ts",
        "lint": "svelte-kit sync && eslint src --ext .ts,.svelte",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "playwright test",
        "test:e2e:deps": "playwright install-deps chromium",
        "test:e2e:browsers": "playwright install chromium",
        "stylelint": "stylelint \"src/**/*.css\"",
        "format": "prettier --write \"src/**/*.{ts,svelte,json}\"",
        "format:check": "prettier --check \"src/**/*.{ts,svelte,json}\""
    },
    "imports": {
        "#lib/*": "./src/lib/*",
        "#components/*": "./src/components/*",
        "#stores/*": "./src/stores/*",
        "#routes/*": "./src/routes/*",
        "#test/*": "./src/__tests__/*"
    },
    "dependencies": {
        "@codemirror/autocomplete": "^6.20.3",
        "@codemirror/commands": "^6.11.1",
        "@codemirror/lang-go": "^6.0.1",
        "@codemirror/lang-javascript": "^6.2.5",
        "@codemirror/lang-python": "^6.2.1",
        "@codemirror/language": "^6.13.1",
        "@codemirror/legacy-modes": "^6.5.5",
        "@codemirror/state": "^6.7.6",
        "@codemirror/theme-one-dark": "^6.1.3",
        "@codemirror/view": "^6.43.14",
        "@internationalized/date": "^3.12.4",
        "@logtape/logtape": "^2.4.1",
        "@lucide/svelte": "^1.55.0",
        "@tanstack/svelte-query": "^6.3.1",
        "@tanstack/svelte-table": "^9.2.8",
        "@uiw/codemirror-theme-bbedit": "^4.25.12",
        "@uiw/codemirror-theme-dracula": "^4.25.12",
        "@uiw/codemirror-theme-github": "^4.25.12",
        "@uiw/codemirror-theme-monokai": "^4.25.12",
        "@uiw/codemirror-theme-vscode": "^4.25.12",
        "anser": "^2.3.5",
        "bits-ui": "^2.19.5",
        "codemirror": "^6.0.2",
        "date-fns": "^4.4.0",
        "formsnap": "^2.0.1",
        "mode-watcher": "^1.1.0",
        "runed": "^0.37.1",
        "svelte": "^5.57.2",
        "svelte-sonner": "^1.2.1",
        "sveltekit-superforms": "^3.0.0",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@babel/runtime": "^8.0.7",
        "@eslint/js": "^10.0.1",
        "@faker-js/faker": "^10.6.0",
        "@hey-api/openapi-ts": "^0.99.0",
        "@playwright/test": "^1.64.0",
        "@sveltejs/adapter-static": "^4.0.0",
        "@sveltejs/kit": "^3.0.1",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "@tailwindcss/forms": "^0.5.11",
        "@tailwindcss/vite": "^4.3.3",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/svelte": "^5.4.2",
        "@testing-library/user-event": "^14.6.7",
        "@typescript-eslint/eslint-plugin": "^8.71.1",
        "@typescript-eslint/parser": "^8.71.1",
        "@vitest/coverage-v8": "^5.0.3",
        "eslint": "^10.12.0",
        "eslint-plugin-svelte": "^3.23.1",
        "globals": "^17.13.0",
        "happy-dom": "^20.14.6",
        "monocart-reporter": "^2.14.1",
        "prettier": "^3.9.10",
        "prettier-plugin-svelte": "^4.1.1",
        "stylelint": "^17.16.0",
        "stylelint-config-standard": "^40.0.0",
        "svelte-check": "^4.7.6",
        "svelte-eslint-parser": "^1.9.0",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0",
        "typescript": "^6.0.3",
        "vitest": "^5.0.3"
    },
    "overrides": {
        "js-yaml": "^4.3.2",
        "postcss-selector-parser": "^7.1.6",
        "runed": {
            "@sveltejs/kit": "$@sveltejs/kit"
        },
        "formsnap": {
            "sveltekit-superforms": "$sveltekit-superforms"
        }
    }
}
