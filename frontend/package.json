{
  "name": "svelte-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npx rollup -c",
    "dev": "npx rollup -c -w",
    "start": "sirv public --single --no-clear --dev --host",
    "generate:api": "openapi-ts",
    "lint": "eslint src --ext .ts,.svelte",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:deps": "playwright install-deps chromium",
    "test:e2e:browsers": "playwright install chromium",
    "stylelint": "stylelint \"src/**/*.css\"",
    "format": "prettier --write \"src/**/*.{ts,svelte,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,svelte,json}\""
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.14",
    "@lucide/svelte": "^1.55.0",
    "@mateothegreat/svelte5-router": "^2.16.19",
    "@uiw/codemirror-theme-bbedit": "^4.25.12",
    "@uiw/codemirror-theme-dracula": "^4.25.12",
    "@uiw/codemirror-theme-github": "^4.25.12",
    "@uiw/codemirror-theme-monokai": "^4.25.12",
    "@uiw/codemirror-theme-vscode": "^4.25.12",
    "ansi_up": "^6.0.6",
    "codemirror": "^6.0.2",
    "consola": "^3.4.2",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.16",
    "svelte": "^5.57.2",
    "svelte-sonner": "^1.2.1"
  },
  "devDependencies": {
    "@babel/runtime": "^8.0.7",
    "@eslint/js": "^10.0.1",
    "@hey-api/openapi-ts": "^0.99.0",
    "@playwright/test": "^1.64.0",
    "@rollup/plugin-alias": "^6.0.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-html": "^2.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.7",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-plugin-svelte": "^3.23.1",
    "express": "^5.3.0",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.6",
    "http-proxy": "^1.18.1",
    "monocart-reporter": "^2.14.1",
    "postcss": "^8.5.29",
    "postcss-lightningcss": "^1.1.1",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "rollup": "^4.64.5",
    "rollup-plugin-cleandir": "^3.0.0",
    "rollup-plugin-css-only": "^4.5.5",
    "rollup-plugin-livereload": "^2.0.5",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-serve": "^3.0.0",
    "rollup-plugin-svelte": "^7.2.3",
    "sirv-cli": "^3.0.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "svelte-check": "^4.7.6",
    "svelte-eslint-parser": "^1.9.0",
    "svelte-preprocess": "^6.0.5",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
