{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "checkJs": false,
    "sourceMap": true
  },
  "include": ["src", "e2e", "playwright.config.ts"],
  "exclude": ["node_modules", "build"]
}
